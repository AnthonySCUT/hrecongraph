+def source_edge(episode_ids, *, group_id='user:u1', uuid='edge-a'):
+    return EntityEdge(
+        uuid=uuid,
+        group_id=group_id,
+        source_node_uuid='node-a',
+        target_node_uuid='node-b',
+        created_at=utc_now(),
+        name='USES',
+        fact='Project A uses Redis',
+        episodes=episode_ids,
+    )
